{
  "name": "commons",
  "private": true,
  "type": "module",
  "bin": {
    "http-server": "esm/bin/http-server.js",
    "lint": "esm/bin/lint.js",
    "ls-workspaces": "esm/bin/ls-workspaces.js",
    "tsc-paths": "esm/bin/tsc-paths.js",
    "view": "esm/bin/view.js"
  },
  "scripts": {
    "build": "yarn build-esm && yarn build-cjs",
    "build-cjs": "rimraf cjs/ && tsc --project tsconfig.cjs.json",
    "build-esm": "rimraf esm/ && tsc --project tsconfig.esm.json",
    "format": "yarn g:prettier --write --config esm/prettier.config.js $(echo \"${@:-.}\")",
    "g:chromatic": "cd $INIT_CWD && yarn g:dotenv-run -- chromatic",
    "g:format": "cd $INIT_CWD && yarn g:prettier --write $(echo \"${@:-.}\")",
    "g:lint": "cd $INIT_CWD && yarn tsc --noEmit && lint",
    "g:lint-staged": "cd $INIT_CWD && yarn run-script $(yarn g:lint-staged-path)",
    "g:lint-staged-path": "yarn bin lint-staged",
    "g:prettier": "cd $INIT_CWD && prettier --ignore-path $PROJECT_CWD/.gitignore --ignore-path $PROJECT_CWD/packages/commons/.prettierignore --ignore-path ./.gitignore --ignore-path ./.prettierignore",
    "g:rimraf": "cd $INIT_CWD && rimraf",
    "g:storybook": "cd $INIT_CWD && yarn g:run-script $(yarn g:storybook-path)",
    "g:storybook-dev": "cd $INIT_CWD && yarn g:run-script $(yarn g:storybook-path) dev",
    "g:storybook-path": "yarn bin storybook",
    "g:vitest": "cd $INIT_CWD && yarn g:run-script $(yarn bin vitest)",
    "g:wait-on": "cd $INIT_CWD && wait-on",
    "lint": "yarn g:prettier --check --config esm/prettier.config.js $(echo \"${@:-.}\") && yarn g:lint \"$@\""
  },
  "dependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/builder-vite": "10.6.4",
    "@types/eslint": "9.6.1",
    "@types/lodash": "4.17.27",
    "@types/react": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@yarnpkg/core": "4.9.1",
    "@yarnpkg/fslib": "3.1.5",
    "arg": "5.0.2",
    "autoprefixer": "10.6.1",
    "chokidar": "6.0.0",
    "cors": "2.8.6",
    "eslint-plugin-mdx": "3.8.2",
    "eslint-plugin-storybook": "10.6.4",
    "glob-to-regexp": "0.4.1",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "lodash": "4.18.1",
    "neostandard": "0.14.1",
    "open": "11.0.4",
    "pnp-sass-importer": "2.0.0",
    "postcss": "8.5.31",
    "postcss-pseudo-classes": "0.4.0",
    "postcss-scss": "4.0.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sirv": "3.0.2",
    "storybook-multilevel-sort": "2.1.0",
    "storybook-zeplin": "4.1.0",
    "ts-enum-util": "4.1.0",
    "turbo": "2.11.10",
    "type-fest": "5.10.0",
    "vite-tsconfig-paths": "6.1.1",
    "wait-on": "9.5.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-links": "10.6.4",
    "@storybook/addon-onboarding": "10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/global": "5.0.0",
    "@types/cors": "2.8.19",
    "@types/glob-to-regexp": "0.4.4",
    "@types/node": "24.19.2",
    "@types/wait-on": "5.3.4",
    "@typescript-eslint/utils": "8.72.0",
    "chromatic": "18.13.3",
    "eslint": "10.13.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-package-json": "1.11.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-packagejson": "3.0.3",
    "prettier-plugin-sh": "0.20.2",
    "rimraf": "6.1.3",
    "sass": "1.106.1",
    "storybook": "10.6.4",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
