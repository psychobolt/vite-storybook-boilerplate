{
  "name": "stylelint-config",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn g:rimraf esm/ && yarn tsc --project tsconfig.esm.json",
    "format": "yarn g:format",
    "lint": "yarn g:prettier --check $(echo \"${@:-.}\") && yarn g:lint \"$@\"",
    "setup": "turbo run build"
  },
  "dependencies": {
    "flat": "6.0.1",
    "postcss": "8.5.32",
    "stylelint-config-hudochenkov": "14.0.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "arg": "5.0.2",
    "commons": "workspace:*",
    "eslint": "10.14.0",
    "stylelint": "18.0.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "stylelint": "*"
  },
  "packageManager": "yarn@4.18.0"
}
