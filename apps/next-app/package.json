{
  "name": "next-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --experimental-https --experimental-https-key $HTTPS_KEY_PATH --experimental-https-cert $HTTPS_CERT_PATH -p $PORT & open-cli $APP_URL --background",
    "dotenv-args": "node ../../bin/dotenv-args.js",
    "run-script": "dotenvx run -q $(yarn dotenv-args) -- node --enable-source-maps --experimental-strip-types --disable-warning=ExperimentalWarning",
    "format": "prettier --ignore-path ../../.gitignore --ignore-path ./.gitignore --write .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "start": "yarn run-script bin/start.ts"
  },
  "resolutions": {
    "html-ui": "portal:../../packages/html-ui",
    "react-ui": "portal:../../packages/react-ui"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.23.0",
    "@types/node": "24.13.3",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/nft": "1.11.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "html-ui": "workspace:*",
    "next": "16.3.4",
    "next-devtools-mcp": "0.4.0",
    "open-cli": "9.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.19.0",
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-ui": "workspace:*",
    "styled-jsx": "5.1.7",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
