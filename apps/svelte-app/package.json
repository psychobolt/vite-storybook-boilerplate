{
	"name": "svelte-app",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"check": "svelte-check",
		"check:watch": "yarn check --watch",
		"dev": "vite dev --open",
		"format": "yarn g:format",
		"lint": "yarn g:prettier --check $(echo \"${@:-.}\") && yarn check && lint --runner stylelint --runner eslint \"$@\"",
		"setup": "turbo run sync",
		"start": "vite preview --open",
		"sync": "svelte-kit sync"
	},
	"devDependencies": {
		"$app": "link:./node_modules/$app",
		"@eslint/js": "10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@neoconfetti/svelte": "2.2.2",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/adapter-vercel": "7.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/mcp": "0.1.28",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/eslint": "9.6.1",
		"@types/eslint-config-prettier": "6.11.3",
		"@types/node": "26.6.6",
		"@typescript-eslint/utils": "8.72.1",
		"commons": "workspace:*",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.14.0",
		"html-ui": "workspace:*",
		"postcss": "8.5.32",
		"postcss-scss": "4.0.9",
		"prettier": "3.9.10",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-sh": "0.20.2",
		"prettier-plugin-svelte": "4.1.1",
		"sass": "1.107.1",
		"stylelint": "17.16.0",
		"stylelint-config-prettier-scss": "1.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"svelte-eslint-parser": "1.10.0",
		"svelte-language-server": "0.18.6",
		"turbo": "2.11.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"wrangler": "4.156.1"
	},
	"packageManager": "yarn@4.18.0"
}
