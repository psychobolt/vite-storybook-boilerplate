{
	"name": "svelte-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "yarn check --watch",
		"dev": "vite dev --open",
		"format": "yarn g:format",
		"lint": "yarn g:prettier --check $(echo \"${@:-.}\") && yarn check && lint --runner stylelint --runner eslint \"$@\"",
		"start": "vite preview --open"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@neoconfetti/svelte": "2.2.2",
		"@sveltejs/adapter-cloudflare": "8.0.0",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/mcp": "0.1.26",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/eslint": "9.6.1",
		"@types/eslint-config-prettier": "6.11.3",
		"@types/node": "24.19.2",
		"@typescript-eslint/utils": "8.71.1",
		"commons": "workspace:*",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"html-ui": "workspace:*",
		"postcss": "8.5.29",
		"postcss-scss": "4.0.9",
		"prettier": "3.9.9",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-sh": "0.20.2",
		"prettier-plugin-svelte": "4.1.1",
		"sass": "1.105.1",
		"stylelint": "17.16.0",
		"stylelint-config-prettier-scss": "1.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "1.9.0",
		"svelte-language-server": "0.18.4",
		"turbo": "2.11.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"wrangler": "4.149.0"
	},
	"packageManager": "yarn@4.18.0"
}
